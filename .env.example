# HIVE — environment variable template
# Copy this file to .env and fill in values.
# .env is gitignored — never commit your actual .env file.

# Ollama configuration (optional — defaults shown)
VITE_OLLAMA_HOST=http://localhost:11434
VITE_OLLAMA_DEFAULT_MODEL=llama3

# App mode
# Set to "electron" when building the desktop app
# ELECTRON=true
